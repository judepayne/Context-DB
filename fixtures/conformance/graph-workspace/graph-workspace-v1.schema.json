{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ctxql:schema:graph-workspace:v1",
  "title": "CTXQL graph workspace v1 closed wire records",
  "oneOf": [
    {"$ref": "#/$defs/apply_request"},
    {"$ref": "#/$defs/apply_response"},
    {"$ref": "#/$defs/view_response"},
    {"$ref": "#/$defs/check_response"},
    {"$ref": "#/$defs/diagnostic"},
    {"$ref": "#/$defs/counters"},
    {"$ref": "#/$defs/transcript_projection"}
  ],
  "$defs": {
    "handle": {"type": "string", "pattern": "^[gncrhq][1-9][0-9]*~[^~]+$", "maxLength": 2048},
    "record_ref": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "handle"], "properties": {"kind": {"const": "handle"}, "handle": {"$ref": "#/$defs/handle"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"const": "temp"}, "id": {"type": "string", "minLength": 1, "maxLength": 2048}}}
      ]
    },
    "literal": {
      "type": "object", "additionalProperties": false,
      "required": ["lexical", "datatype", "language"],
      "properties": {"lexical": {"type": "string", "maxLength": 16384}, "datatype": {"type": "string", "minLength": 1, "maxLength": 2048}, "language": {"type": ["string", "null"], "maxLength": 2048}}
    },
    "endpoint_ref": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "record"], "properties": {"kind": {"const": "record"}, "record": {"$ref": "#/$defs/record_ref"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "literal"}, "value": {"$ref": "#/$defs/literal"}}}
      ]
    },
    "add_node": {
      "type": "object", "additionalProperties": false, "required": ["op", "temp_id", "local_id", "label", "evidence"],
      "properties": {"op": {"const": "add_node"}, "temp_id": {"type": "string"}, "local_id": {"type": "string"}, "label": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}, "maxItems": 32}}
    },
    "add_claim": {
      "type": "object", "additionalProperties": false, "required": ["op", "temp_id", "subject", "predicate", "object", "evidence", "fit_note"],
      "properties": {"op": {"const": "add_claim"}, "temp_id": {"type": "string"}, "subject": {"$ref": "#/$defs/record_ref"}, "predicate": {"type": "string"}, "object": {"$ref": "#/$defs/endpoint_ref"}, "evidence": {"type": "array", "items": {"type": "string"}, "maxItems": 32}, "fit_note": {"type": "string", "maxLength": 2048}}
    },
    "add_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "temp_id", "label", "scope", "definition_evidence", "referent_shape", "target_text", "members", "membership_evidence", "status"],
      "properties": {"op": {"const": "add_reference"}, "temp_id": {"type": "string"}, "label": {"type": "string"}, "scope": {"type": "string"}, "definition_evidence": {"type": "array", "items": {"type": "string"}, "maxItems": 32}, "referent_shape": {"type": "string"}, "target_text": {"type": ["string", "null"]}, "members": {"type": "array", "items": {"$ref": "#/$defs/record_ref"}}, "membership_evidence": {"type": "array", "items": {"type": "string"}, "maxItems": 32}, "status": {"enum": ["unresolved", "partial", "resolved"]}}
    },
    "add_hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "temp_id", "proposed", "existing", "comparison_evidence", "note"],
      "properties": {"op": {"const": "add_hypothesis"}, "temp_id": {"type": "string"}, "proposed": {"$ref": "#/$defs/record_ref"}, "existing": {"$ref": "#/$defs/record_ref"}, "comparison_evidence": {"type": "array", "items": {"type": "string"}, "maxItems": 32}, "note": {"type": "string", "maxLength": 2048}}
    },
    "add_question": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "temp_id", "code", "message", "relevant"],
      "properties": {"op": {"const": "add_question"}, "temp_id": {"type": "string"}, "code": {"type": "string"}, "message": {"type": "string"}, "relevant": {"type": "array", "items": {"$ref": "#/$defs/record_ref"}}}
    },
    "withdraw": {"type": "object", "additionalProperties": false, "required": ["op", "handle"], "properties": {"op": {"const": "withdraw"}, "handle": {"$ref": "#/$defs/handle"}}},
    "edit": {"oneOf": [{"$ref": "#/$defs/add_node"}, {"$ref": "#/$defs/add_claim"}, {"$ref": "#/$defs/add_reference"}, {"$ref": "#/$defs/add_hypothesis"}, {"$ref": "#/$defs/add_question"}, {"$ref": "#/$defs/withdraw"}]},
    "apply_request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "session_id", "expected_revision", "idempotency_key", "edits"],
      "properties": {"schema": {"const": "ctxql.graph-workspace/v1"}, "session_id": {"type": "string"}, "expected_revision": {"type": "integer", "minimum": 0}, "idempotency_key": {"type": "string", "minLength": 1}, "edits": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/edit"}}}
    },
    "apply_response": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "operation_id", "revision", "idempotent_replay", "handles"],
      "properties": {"schema": {"const": "ctxql.graph-workspace/v1"}, "operation_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "idempotent_replay": {"type": "boolean"}, "handles": {"type": "object", "additionalProperties": {"$ref": "#/$defs/handle"}}}
    },
    "view_response": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "revision", "kind", "rendered", "view_partial", "omitted_records", "included_handles"],
      "properties": {"schema": {"const": "ctxql.graph-workspace/v1"}, "revision": {"type": "integer", "minimum": 0}, "kind": {"enum": ["overview", "neighbourhood", "changes", "open_questions"]}, "rendered": {"type": "string"}, "view_partial": {"type": "boolean"}, "omitted_records": {"type": "integer", "minimum": 0}, "included_handles": {"type": "array", "items": {"$ref": "#/$defs/handle"}}}
    },
    "check_response": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "revision", "structurally_valid", "issues", "check_partial", "omitted_issues", "note"],
      "properties": {"schema": {"const": "ctxql.graph-workspace/v1"}, "revision": {"type": "integer", "minimum": 0}, "structurally_valid": {"type": "boolean"}, "issues": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "severity", "handles", "message"], "properties": {"code": {"type": "string"}, "severity": {"enum": ["error", "warning"]}, "handles": {"type": "array", "items": {"$ref": "#/$defs/handle"}}, "message": {"type": "string"}}}}, "check_partial": {"type": "boolean"}, "omitted_issues": {"type": "integer", "minimum": 0}, "note": {"type": "string"}}
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "code", "message", "limit", "retryable"],
      "properties": {"schema": {"const": "ctxql.graph-workspace/v1"}, "code": {"enum": ["invalid_request", "unknown_handle", "foreign_handle", "wrong_handle_type", "foreign_evidence", "immutable_import", "revision_conflict", "idempotency_conflict", "dependency_pinned", "limit_exceeded", "cancelled", "query_too_broad", "query_incomplete", "workspace_capacity", "execution_exhausted", "timeout", "authority_denied"]}, "message": {"type": "string"}, "limit": {"type": ["string", "null"]}, "retryable": {"type": "boolean"}}
    },
    "counters": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_calls", "graph_queries", "aggregate_request_bytes", "aggregate_response_bytes", "retained_state_bytes", "live_graphs", "imported_nodes", "imported_claims", "draft_nodes", "draft_edges"],
      "properties": {"tool_calls": {"type": "integer", "minimum": 0}, "graph_queries": {"type": "integer", "minimum": 0}, "aggregate_request_bytes": {"type": "integer", "minimum": 0}, "aggregate_response_bytes": {"type": "integer", "minimum": 0}, "retained_state_bytes": {"type": "integer", "minimum": 0}, "live_graphs": {"type": "integer", "minimum": 0}, "imported_nodes": {"type": "integer", "minimum": 0}, "imported_claims": {"type": "integer", "minimum": 0}, "draft_nodes": {"type": "integer", "minimum": 0}, "draft_edges": {"type": "integer", "minimum": 0}}
    },
    "transcript_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "ordinal", "operation_id", "request", "response", "revision_before", "revision_after", "state_root", "dependencies"],
      "properties": {"schema": {"const": "ctxql.graph-workspace-transcript-projection/v1"}, "ordinal": {"type": "integer", "minimum": 0}, "operation_id": {"type": "string"}, "request": {}, "response": {}, "revision_before": {"type": "integer", "minimum": 0}, "revision_after": {"type": "integer", "minimum": 0}, "state_root": {"type": "string"}, "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
    }
  }
}
