  "always_on_equality": {
    "diagnostic_key": "eq-union",
    "behavior": "asserted owl:sameAs and identity-rule output are unioned before non-identity rules; output is a canonical star, not a full pairwise clique",
    "subject_object_canonicalization": true
  },
  "structural_contract": {
    "list_predicates": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#first",
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest",
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"
    ],
    "facets": [
      "http://www.w3.org/2002/07/owl#onProperty",
      "http://www.w3.org/2002/07/owl#hasValue",
      "http://www.w3.org/2002/07/owl#someValuesFrom",
      "http://www.w3.org/2002/07/owl#allValuesFrom",
      "http://www.w3.org/2002/07/owl#maxCardinality",
      "http://www.w3.org/2002/07/owl#maxQualifiedCardinality",
      "http://www.w3.org/2002/07/owl#onClass",
      "http://www.w3.org/2002/07/owl#intersectionOf",
      "http://www.w3.org/2002/07/owl#unionOf",
      "http://www.w3.org/2002/07/owl#oneOf",
      "http://www.w3.org/2002/07/owl#propertyChainAxiom",
      "http://www.w3.org/2002/07/owl#hasKey",
      "http://www.w3.org/2002/07/owl#inverseOf"
    ],
    "required_shapes": [
      "property chains use a reasoner-visible rdf:first/rdf:rest spine of at least two reference-valued members",
      "keys use a nonempty reasoner-visible reference-valued RDF list",
      "restrictions are rdf:type owl:Restriction and have reference-valued owl:onProperty",
      "maxCardinality is native Long(1)",
      "maxQualifiedCardinality is native Long(1) and has reference-valued owl:onClass",
      "intersectionOf, unionOf, and oneOf use nonempty reasoner-visible RDF lists"
    ],
    "native_limits": {"max_list_length": 10000, "max_inverse_expression_depth": 10}
  },
  "term_restrictions": {
    "reference_only": ["rdfs:range object", "owl:hasValue", "owl:oneOf members", "owl:hasKey values"],
    "literal_copying": "prp-spo1 preserves the complete native FlakeValue and datatype",
    "domain_accepts_literal_object": true,
    "range_ignores_literal_object": true
  },
  "native_silent_ignore": [
    "property chains shorter than two",
    "empty key lists",
    "missing or non-reference restriction facets",
    "literal hasValue",
    "literal members skipped by collect_list_elements",
    "max cardinality values other than native Long(1)",
    "malformed or unterminated lists may be consumed as a short prefix"
  ],
  "unsupported_neighboring_constructs": [
    "owl:equivalentProperty", "owl:complementOf", "owl:disjointWith",
    "owl:AllDifferent", "owl:differentFrom", "datatype reasoning",
    "owl:minCardinality", "owl:cardinality", "max cardinality zero",
    "max cardinality greater than one", "literal owl:hasValue",
    "literal owl:oneOf", "literal key values"
  ],
