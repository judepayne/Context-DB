{
  "$defs": {
    "module": {
      "additionalProperties": false,
      "properties": {
        "conversion_root": {"$ref": "#/$defs/root"},
        "graph_iri": {"format": "uri", "type": "string"},
        "ontology_iri": {"format": "uri", "type": "string"},
        "source_release_id": {"$ref": "#/$defs/root"}
      },
      "required": ["ontology_iri", "source_release_id", "conversion_root", "graph_iri"],
      "type": "object"
    },
    "root": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}
  },
  "$id": "ctxql.p6-executable-profile-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_root": {"$ref": "#/$defs/root"},
    "complete_closure_root": {"$ref": "#/$defs/root"},
    "complete_source_quad_root": {"$ref": "#/$defs/root"},
    "conversion_root": {"$ref": "#/$defs/root"},
    "dependency_universe_root": {"$ref": "#/$defs/root"},
    "extraction_eligibility_root": {"$ref": "#/$defs/root"},
    "fluree_revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "graph_map_root": {"$ref": "#/$defs/root"},
    "limits_identity": {"$ref": "#/$defs/root"},
    "profile_result_root": {"$ref": "#/$defs/root"},
    "reasoner_projection_root": {"$ref": "#/$defs/root"},
    "reference_root": {"$ref": "#/$defs/root"},
    "schema": {"const": "ctxql.p6-executable-profile/v2"},
    "selected_entry_iris": {"items": {"format": "uri", "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "selected_modules": {"items": {"$ref": "#/$defs/module"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "source_release_ids": {"items": {"$ref": "#/$defs/root"}, "minItems": 2, "type": "array", "uniqueItems": true},
    "vocabulary_status_root": {"$ref": "#/$defs/root"}
  },
  "required": ["schema", "dependency_universe_root", "reference_root", "source_release_ids", "selected_entry_iris", "selected_modules", "conversion_root", "complete_closure_root", "graph_map_root", "complete_source_quad_root", "profile_result_root", "reasoner_projection_root", "limits_identity", "catalog_root", "vocabulary_status_root", "extraction_eligibility_root", "fluree_revision"],
  "type": "object"
}
