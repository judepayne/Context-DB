# Synthetic offline Gate F corpus; no external ontology or network dependency.
@prefix ex: <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

ex:fixture a owl:Ontology ;
  owl:versionInfo "gate-f-v1" .
ex:Manager rdfs:subClassOf ex:Person ;
  rdfs:label "Manager" .
ex:manages rdfs:subPropertyOf ex:knows ;
  rdfs:domain ex:Manager ;
  rdfs:range ex:Person .
ex:parent owl:inverseOf ex:child .
ex:Supervisor owl:equivalentClass ex:Manager .
ex:knows a owl:SymmetricProperty .
